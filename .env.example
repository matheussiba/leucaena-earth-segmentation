# Copy to .env (never commit .env):
#   cp .env.example .env
#
# Dataset on local disk (no Google Drive / no spaces in path):
#   C:/00_DATASETS_AI/<dataset-id>/{tiles,annotations,lidar}/
#
# Run docker compose from WSL — use /mnt/c/... paths:

LEUCAENA_DATASET_ID=260515-piracicaba-aoi

# --- RGBN tiles + GeoJSON masks (required) -------------------------------
LEUCAENA_TILES_HOST_DIR=/mnt/c/00_DATASETS_AI/260515-piracicaba-aoi/tiles
LEUCAENA_MASKS_HOST_DIR=/mnt/c/00_DATASETS_AI/260515-piracicaba-aoi/annotations
LEUCAENA_TILES_DIR=/data/rgbir
LEUCAENA_MASKS_PATH=/data/masks/polygons.geojson

# --- LiDAR pipeline (optional; used by prep-lidar-rasters.py) ------------
# LAZ point clouds on the host (typically a different disk: D:\ -> /mnt/d/).
# Set the LIDAR_HOST_DIR to where you want the resulting 2-band GeoTIFFs
# (CHM, INTENSITY) to be stored; this is also what prep-patches-from-tiles.py
# reads as --lidar-dir.
LEUCAENA_LAZ_HOST_DIR=/mnt/d/laz
LEUCAENA_LIDAR_HOST_DIR=/mnt/c/00_DATASETS_AI/260515-piracicaba-aoi/lidar
LEUCAENA_LAZ_DIR=/data/laz
LEUCAENA_LIDAR_DIR=/data/lidar
