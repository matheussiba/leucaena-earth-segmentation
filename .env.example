# Copy to .env and edit (never commit .env):
#   cp .env.example .env
#
# Recommended layout (one folder per AOI / export):
#
#   <PHD>/00-datasets-ai/<dataset-id>/
#     tiles/              RGB+IR GeoTIFFs (*.tif)
#     annotations/
#       polygons.geojson  labels from leucaena.earth (or QGIS)
#       platform-backup/  optional .db exports (not used by training)
#
# Example: 260515-piracicaba-aoi

LEUCAENA_DATASET_ID=260515-piracicaba-aoi
LEUCAENA_TILES_HOST_DIR=G:/My Drive/PHD/02-Tese/00-datasets-ai/260515-piracicaba-aoi/tiles
LEUCAENA_MASKS_HOST_DIR=G:/My Drive/PHD/02-Tese/00-datasets-ai/260515-piracicaba-aoi/annotations

# Container paths (match docker-compose volume targets):
LEUCAENA_TILES_DIR=/data/rgbir
LEUCAENA_MASKS_PATH=/data/masks/polygons.geojson
