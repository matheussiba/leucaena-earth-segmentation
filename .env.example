# Copy to .env (never commit .env):
#   cp .env.example .env
#
# =========================================================================
# FLUXO PhD UNIFICADO (scripts/phd-run) - a unica superficie por PC
# =========================================================================
# PHD_RUN_ROOT deriva TUDO: tiles/ aois/ annotations/ datasets/ experiments/ reports/
#   home:  PHD_RUN_ROOT=C:/00_PHD_MSB_RUN
#   lab:   PHD_RUN_ROOT=E:/dados-msb/00_PHD_MSB_RUN
PHD_RUN_ROOT=C:/00_PHD_MSB_RUN
# home = PC pessoal | lab = laboratorio (batch/workers por profile no experiment.yaml)
TRAIN_PROFILE=home
# Rscript do orquestrador LiDAR (engines r | geotrees; so se nao estiver no PATH):
#   R_BIN=C:/Program Files/R/R-4.4.1/bin/Rscript.exe
# R_BIN=
# LAStools (opcional; so -Engine geotrees -GeotreesProtocol catalog):
# LASTOOLS_PATH=C:/LAStools/bin
#
# Tudo o mais (rede, fusion, task, patch, epochs, loss...) fica no
# experiments/<rede>/<nome>/experiment.yaml, NAO aqui.
#
# =========================================================================
# LEGADO (pipeline antigo por-AOI) - mantido so p/ compatibilidade
# =========================================================================
# --- Raiz dos datasets (MUDA POR PC) ------------------------------------
# Casa / notebook:
#   DIR_DATASETS_AI_PATH=C:/00_DATASETS_AI
# Laboratorio (exemplo):
#   DIR_DATASETS_AI_PATH=E:/dados-msb/00_DATASETS_AI
#
# AOI usada pelo teste MANet = DIR_DATASETS_AI_PATH / LEUCAENA_DATASET_ID

DIR_DATASETS_AI_PATH=C:/00_DATASETS_AI
LEUCAENA_DATASET_ID=261002-riodaspedras-aoi

# --- Perfil de treino MANet (MUDA POR PC) --------------------------------
# home = PC pessoal | lab = laboratorio (batch/workers)
TRAIN_PROFILE=home
#
# Pasta do experimento sob <AOI>/experiments/<EXPERIMENT_NAME>/
# v1 (ja rodado): manet-latefusion-multitask   <- nao apagar
# v2 (atual):     manet-latefusion-multitask-v2  (patch 512, CHM filter so com LiDAR)
EXPERIMENT_NAME=manet-latefusion-multitask-v2

# --- Orquestrador LiDAR (abordagem C) ------------------------------------
# So necessario se 'Rscript' nao estiver no PATH do PC (passo R/lidR).
#   home: R_BIN=C:/Program Files/R/R-4.4.1/bin/Rscript.exe
#   lab:  R_BIN=C:/Program Files/R/R-4.4.1/bin/Rscript.exe
# R_BIN=

# --- Abaixo: mounts do docker-compose da RAIZ (pipeline ResUNet) --------
# Em WSL use /mnt/c/... ou /mnt/e/... . No laboratorio com E: :
#   /mnt/e/dados-msb/00_DATASETS_AI/<dataset-id>/...

# --- RGBN tiles + GeoJSON masks (required) -------------------------------
LEUCAENA_TILES_HOST_DIR=/mnt/c/00_DATASETS_AI/261002-riodaspedras-aoi/opt/rgbnir
LEUCAENA_MASKS_HOST_DIR=/mnt/c/00_DATASETS_AI/261002-riodaspedras-aoi/annotations
LEUCAENA_TILES_DIR=/data/rgbir
LEUCAENA_MASKS_PATH=/data/masks/leucaena-polygons.geojson

# --- LiDAR pipeline ------------------------------------------------------
LEUCAENA_LAZ_HOST_DIR=/mnt/c/00_DATASETS_AI/261002-riodaspedras-aoi/lidar/raw
LEUCAENA_LIDAR_HOST_DIR=/mnt/c/00_DATASETS_AI/261002-riodaspedras-aoi/lidar/rasters
LEUCAENA_LAZ_DIR=/data/laz
LEUCAENA_LIDAR_DIR=/data/lidar

# --- Patches -------------------------------------------------------------
LEUCAENA_PATCHES_HOST_DIR=/mnt/c/00_DATASETS_AI/261002-riodaspedras-aoi/patches
LEUCAENA_PATCHES_DIR=/data/patches

# --- Predictions ---------------------------------------------------------
LEUCAENA_PREDICTIONS_HOST_DIR=/mnt/c/00_DATASETS_AI/261002-riodaspedras-aoi/predictions
LEUCAENA_PREDICTIONS_DIR=/data/predictions
